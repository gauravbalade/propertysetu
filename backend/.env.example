# Copy to .env.local (never commit .env.local).
# Local MySQL database. Change port/username/password to match your installation.
DB_URL=jdbc:mysql://localhost:3306/property_registration_db?useSSL=false&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=property-registration-system
DDL_AUTO=update
SHOW_SQL=false
SERVER_PORT=8080
UPLOAD_DIR=../demo/uploads
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=

# Optional first-run admin seed for a NEW local database only.
# Set all three values together. Use a unique username/email and a 12+ character password.
# Existing accounts are never overwritten. Remove ADMIN_BOOTSTRAP_PASSWORD after first startup.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Razorpay Test Mode only. Leave blank if checkout is not configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional provider configuration.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=PropertySetu
