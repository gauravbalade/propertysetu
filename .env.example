# Copy values into your hosting provider's environment settings.
# Never commit real values to GitHub.
DB_URL=jdbc:mysql://your-managed-mysql-host:3306/property_registration_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=propertysetu-production
DDL_AUTO=validate
SHOW_SQL=false
FORMAT_SQL=false
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=6MB
UPLOAD_DIR=/app/uploads
FRONTEND_ORIGIN=https://your-frontend-domain.example
SERVER_PORT=8080
